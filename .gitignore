# Local Terraform directories
.terraform/
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files to prevent committing sensitive variables
*.tfvars
*.tfvars.json

# Ignore override files as they are usually temporary
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to prevent leaking sensitive data
*.tfplan

# Directory for locally stored plans
.tfplans/
